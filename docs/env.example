# Environment variables for Bond-with-your-dog (copy to .env.local / Vercel project settings).
# Local dev: scripts/seed-local.sh writes a working .env.local for the local Supabase.

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key>          # server only

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.bonded.dog
ADMIN_EMAILS=you@example.com                                    # bootstrap owners (comma-separated)
# Legacy: the registered name now lives in Settings → General → Business details; this is only the fallback.
NEXT_PUBLIC_LEGAL_NAME=<registered business name for Terms/Refund/Privacy>

# ── Payments ─────────────────────────────────────────────
PAYMENTS_PROVIDER=paddle                                        # "paddle" | "test" (test = local only, blocked in production)
PADDLE_ENV=sandbox                                              # "sandbox" | "production"
PADDLE_API_KEY=<server API key>                                 # server only
PADDLE_WEBHOOK_SECRET=<notification destination secret>         # server only
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<client-side token>
NEXT_PUBLIC_PADDLE_ENV=sandbox                                  # must match PADDLE_ENV

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=<key>
EMAIL_FROM="Bonded <hello@bonded.dog>"
COACH_INBOX=<where "Ask the coach" questions and overdue-feedback alerts go>

# ── Scheduled reminders (Vercel Cron → /api/cron/reminders, see vercel.json) ──
CRON_SECRET=<random string, at least 16 characters>             # server only; Vercel Cron sends it as a Bearer token

# ── Phone notifications (Web Push) ───────────────────────
# Generate once with `npx web-push generate-vapid-keys`. Without both keys the Settings card is hidden.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<public key>
VAPID_PRIVATE_KEY=<private key>                                  # server only
VAPID_SUBJECT=mailto:<team address>                              # optional; defaults to https://www.bonded.dog

# ── Bot protection on public forms (Cloudflare Turnstile) ─
# Sign-up, the quiz and "Share your story". Without the keys the forms stay open (and say so in the logs).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key>
TURNSTILE_SECRET_KEY=<secret key>                                # server only

# ── Analytics ────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=<project key>

# ── Video ────────────────────────────────────────────────
# Vimeo needs no keys (links are pasted per lesson). Mux is used for student uploads:
MUX_TOKEN_ID=<id>
MUX_TOKEN_SECRET=<secret>
MUX_SIGNING_KEY_ID=<id>
MUX_SIGNING_KEY_PRIVATE=<base64 private key>
